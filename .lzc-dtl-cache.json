{
  "name": "Kamifaka",
  "package": "cloud.lazycat.app.kamifaka",
  "description": "kfa",
  "homepage": "https://github.com/Baiyuetribe/kamiFaka",
  "author": "Baiyuetribe",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "kamifaka",
  "version": "0.0.1",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "kamifaka_8000_8000": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_baiyuetribe_kamifaka": {
    "originalImage": "baiyuetribe/kamifaka",
    "pushTarget": "none"
  },
  "kamifaka_volume_/usr/src/app/database_action": "emptyDir",
  "kamifaka_volume_/usr/src/app/database_location": "app_data"
}
